# Copy to .env and edit as needed:  cp .env.example .env
# docker compose reads .env automatically.

# ROS namespace for this robot, WITHOUT a leading slash.
# Must match the namespace configured on the robot itself.
CREATE3_NAMESPACE=cpsl_ugv_1

# Must match the robot's ROS 2 Domain ID.
ROS_DOMAIN_ID=0

# Addresses on the direct robot link.
CREATE3_ROBOT_IP=192.168.186.2
CREATE3_HOST_IP=192.168.186.3

# Web GUI.
#
# CREATE3_WEB_TOKEN is the ONLY thing standing between the robot and anyone who
# can reach this port. Leaving it empty disables authentication entirely: the
# page, the telemetry API and the teleop controls are all open. The server binds
# every interface by default, which on a lab or campus network means the robot is
# drivable by any host on that network.
#
# Generate a fresh one -- do not invent one by hand, and do not reuse it between
# machines:
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Put it in .env (this file is the template; .env is gitignored, so the token is
# never committed). Keep .env mode 600:  chmod 600 .env
# The browser then needs it in the URL:  http://<host>:8080/?token=<token>
#
# To rotate it: generate a new value, edit .env, `docker compose up -d web`.
CREATE3_WEB_PORT=8080
CREATE3_WEB_TOKEN=

# Bind address. 0.0.0.0 is reachable on every interface this host has, including
# any wifi it is joined to. Set it to the robot-subnet address to restrict the
# GUI to that link -- more secure, but then it is not reachable from a laptop or
# phone on wifi, which is usually the point of having it.
CREATE3_WEB_HOST=0.0.0.0

# Telemetry push rate, Hz.
CREATE3_WEB_TELEMETRY_HZ=10
# Teleop speed caps, in m/s and rad/s.
CREATE3_WEB_MAX_LINEAR=0.31
CREATE3_WEB_MAX_ANGULAR=1.90

# Own the files the container writes into bind mounts. `id -u` / `id -g`.
USER_UID=1000
USER_GID=1000

# ROS_DISTRO=jazzy
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Do NOT set FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA here. The Create 3 runs a
# ROS 2 Iron stack that will not negotiate it, and the result is a robot whose
# nodes and topics list normally while no message ever arrives.
