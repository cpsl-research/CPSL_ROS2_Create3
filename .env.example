# Copy to .env and edit as needed:  cp .env.example .env
# docker compose reads .env automatically.

# ROS namespace for this robot, WITHOUT a leading slash.
# Must match the namespace configured on the robot itself.
CREATE3_NAMESPACE=cpsl_ugv_1

# Must match the robot's ROS 2 Domain ID.
ROS_DOMAIN_ID=0

# Addresses on the direct robot link.
CREATE3_ROBOT_IP=192.168.186.2
CREATE3_HOST_IP=192.168.186.3

# Own the files the container writes into bind mounts. `id -u` / `id -g`.
USER_UID=1000
USER_GID=1000

# ROS_DISTRO=jazzy
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Do NOT set FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA here. The Create 3 runs a
# ROS 2 Iron stack that will not negotiate it, and the result is a robot whose
# nodes and topics list normally while no message ever arrives.
