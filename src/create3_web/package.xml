<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>create3_web</name>
  <version>0.1.0</version>
  <description>Lightweight web GUI for operating and monitoring a CPSL iRobot Create 3: live telemetry, dock/undock, and keyboard teleop from a browser.</description>
  <maintainer email="dmh89@duke.edu">David Hunt</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>irobot_create_msgs</depend>
  <depend>python3-fastapi</depend>
  <depend>python3-uvicorn</depend>
  <depend>python3-websockets</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
